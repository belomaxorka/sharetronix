<IfModule mod_rewrite.c>
	RewriteEngine Off
</ifModule>

FileETag INode MTime Size

<ifModule mod_expires.c>
	ExpiresActive On
	ExpiresDefault "access plus 300 days"
</ifModule>

<IfModule mod_gzip.c>
	mod_gzip_on Yes
	mod_gzip_dechunk Yes
	mod_gzip_item_include file \.(js|css)$
	mod_gzip_item_include mime ^text/.*
</IfModule>

<IfModule !mod_gzip.c>
	<IfModule mod_deflate.c>
		<FilesMatch "\.(js|css)$">
			SetOutputFilter DEFLATE
		</FilesMatch>
	</IfModule>
</IfModule>

#php_flag engine off 
AddType text/plain .php .php2 .php3 .php4 .php5 .php6 .php7 .phps .pht .phtm .phtml .phar .pl .py .jsp .asp .aspx .shtml .sh .cgi .htm .html .svg .svgz .xml .xhtml
RemoveHandler .php .php2 .php3 .php4 .php5 .php6 .php7 .phps .pht .phtm .phtml .phar .pl .py .jsp .asp .aspx .shtml .sh .cgi .htm .html .svg .svgz .xml .xhtml
RemoveType .php .php2 .php3 .php4 .php5 .php6 .php7 .phps .pht .phtm .phtml .phar .pl .py .jsp .asp .aspx .shtml .sh .cgi .htm .html .svg .svgz .xml .xhtml

# Deny direct execution/serving of scripts and active markup regardless of handler (e.g. PHP-FPM).
<IfModule mod_authz_core.c>
	<FilesMatch "\.(php[0-9]?|phps|pht|phtm|phtml|phar|pl|py|jsp|asp|aspx|shtml|sh|cgi|svg|svgz|xml|xhtml|htm|html)$">
		Require all denied
	</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
	<FilesMatch "\.(php[0-9]?|phps|pht|phtm|phtml|phar|pl|py|jsp|asp|aspx|shtml|sh|cgi|svg|svgz|xml|xhtml|htm|html)$">
		Order allow,deny
		Deny from all
	</FilesMatch>
</IfModule>
